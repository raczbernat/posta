[
  {
    "type": "post",
    "url": "/login",
    "title": "Bejelentkezés",
    "name": "Login",
    "group": "Auth",
    "version": "1.0.0",
    "description": "<p>E-mail és jelszó alapján Bearer tokent ad.</p>",
    "body": [
      {
        "group": "Body",
        "type": "String",
        "optional": false,
        "field": "email",
        "isArray": false,
        "description": "<p>E-mail cím</p>"
      },
      {
        "group": "Body",
        "type": "String",
        "optional": false,
        "field": "password",
        "isArray": false,
        "description": "<p>Jelszó</p>"
      }
    ],
    "success": {
      "fields": {
        "Success 200": [
          {
            "group": "Success 200",
            "type": "String",
            "optional": false,
            "field": "token",
            "isArray": false,
            "description": "<p>Bearer token</p>"
          }
        ]
      },
      "examples": [
        {
          "title": "Siker (200):",
          "content": "{\"token\": \"2|xyz789...\", \"user\": {\"id\": 1, \"name\": \"Teszt Elek\", \"email\": \"teszt@example.com\"}}",
          "type": "json"
        }
      ]
    },
    "error": {
      "fields": {
        "401": [
          {
            "group": "401",
            "optional": false,
            "field": "Unauthorized",
            "isArray": false,
            "description": "<p>Hibás e-mail vagy jelszó</p>"
          }
        ]
      }
    },
    "filename": "AuthController.php",
    "groupTitle": "Auth"
  },
  {
    "type": "post",
    "url": "/register",
    "title": "Regisztráció",
    "name": "Register",
    "group": "Auth",
    "version": "1.0.0",
    "description": "<p>Új felhasználót hoz létre és visszaad egy Bearer tokent.</p>",
    "body": [
      {
        "group": "Body",
        "type": "String",
        "optional": false,
        "field": "name",
        "isArray": false,
        "description": "<p>Név</p>"
      },
      {
        "group": "Body",
        "type": "String",
        "optional": false,
        "field": "email",
        "isArray": false,
        "description": "<p>E-mail cím</p>"
      },
      {
        "group": "Body",
        "type": "String",
        "optional": false,
        "field": "password",
        "isArray": false,
        "description": "<p>Jelszó (min. 8 karakter)</p>"
      }
    ],
    "success": {
      "fields": {
        "201": [
          {
            "group": "201",
            "type": "String",
            "optional": false,
            "field": "token",
            "isArray": false,
            "description": "<p>Bearer token</p>"
          }
        ]
      },
      "examples": [
        {
          "title": "Siker (201):",
          "content": "{\"token\": \"1|abc123...\", \"user\": {\"id\": 1, \"name\": \"Teszt Elek\", \"email\": \"teszt@example.com\"}}",
          "type": "json"
        }
      ]
    },
    "error": {
      "fields": {
        "422": [
          {
            "group": "422",
            "optional": false,
            "field": "ValidationError",
            "isArray": false,
            "description": "<p>Hibás vagy hiányzó mező</p>"
          }
        ]
      }
    },
    "filename": "AuthController.php",
    "groupTitle": "Auth"
  },
  {
    "type": "get",
    "url": "/megyek",
    "title": "Megyék listája",
    "name": "MegyekIndex",
    "group": "Megyek",
    "version": "1.0.0",
    "description": "<p>Az összes megye név szerint rendezve (a szűréshez használható <code>megye_id</code>-kkal).</p>",
    "success": {
      "examples": [
        {
          "title": "Siker (200):",
          "content": "HTTP/1.1 200 OK\n[\n  {\"id\": 1, \"nev\": \"Bács-Kiskun\"},\n  {\"id\": 2, \"nev\": \"Baranya\"}\n]",
          "type": "json"
        }
      ]
    },
    "filename": "MegyeController.php",
    "groupTitle": "Megyek"
  },
  {
    "type": "delete",
    "url": "/telepulesek/:id",
    "title": "Település törlése",
    "name": "TelepulesDestroy",
    "group": "Telepulesek",
    "version": "1.0.0",
    "permission": [
      {
        "name": "token"
      }
    ],
    "header": {
      "fields": {
        "Header": [
          {
            "group": "Header",
            "type": "String",
            "optional": false,
            "field": "Authorization",
            "isArray": false,
            "description": "<p><code>Bearer &lt;token&gt;</code></p>"
          }
        ]
      }
    },
    "parameter": {
      "fields": {
        "Parameter": [
          {
            "group": "Parameter",
            "type": "Number",
            "optional": false,
            "field": "id",
            "isArray": false,
            "description": "<p>Település azonosító</p>"
          }
        ]
      }
    },
    "success": {
      "fields": {
        "204": [
          {
            "group": "204",
            "type": "null",
            "optional": false,
            "field": "-",
            "isArray": false,
            "description": "<p>Sikeres törlés, nincs választörzs</p>"
          }
        ]
      }
    },
    "error": {
      "fields": {
        "401": [
          {
            "group": "401",
            "optional": false,
            "field": "Unauthenticated",
            "isArray": false,
            "description": "<p>Hiányzó vagy érvénytelen token</p>"
          }
        ],
        "404": [
          {
            "group": "404",
            "optional": false,
            "field": "NotFound",
            "isArray": false,
            "description": "<p>Nincs ilyen település</p>"
          }
        ]
      }
    },
    "filename": "TelepulesController.php",
    "groupTitle": "Telepulesek"
  },
